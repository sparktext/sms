# --- Core (REQUIRED: the app refuses to start without SECRET_KEY and DATABASE_URL) ---
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins incl. scheme; needed in prod, e.g. https://app.example.com
CSRF_TRUSTED_ORIGINS=
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Database ---
# Local dev: the Postgres container from docker-compose (or a native local Postgres).
# Never point local dev at a shared/staging/production database.
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgres://postgres:sparktext@localhost:5432/sparktext
# Defaults: disable when DEBUG=True, require otherwise
DB_SSLMODE=
# HSTS seconds in production (start small, raise to 31536000 once HTTPS is stable)
SECURE_HSTS_SECONDS=3600

# Google OAuth (Provide either CLIENT_ID + CLIENT_SECRET or GOOGLE_OAUTH_JSON_PATH)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_JSON_PATH=secrets/google_oauth.json

# Email Configuration
# Option A: Brevo API
BREVO_API_KEY=your-brevo-api-key-here
ANYMAIL_WEBHOOK_SECRET=your-webhook-secret-here

# Option B: SMTP (e.g. Hostinger, Gmail)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=info@sparktext.si
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=SparkText <info@sparktext.si>
REDIS_URL=redis://localhost:6379/0
HTTPS_ONLY=False
TURNSTILE_ENABLED=False
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Telnyx
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_PHONE_NUMBER=
# AI
AI_CLIENT=openai
AI_BASE_URL=http://localhost:1235/v1
AI_MODEL=google/gemma-4-12b-qat
AI_API_KEY=


# --- Logging (stdout) ---
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# Local dev only: set to pubsub if your local Redis is older than 5.0 (live updates fail with
# "unknown command 'BZPOPMIN'"). Better: run Redis 7 (docker run -p 6379:6379 redis:7.4-alpine).
# CHANNEL_LAYER_MODE=pubsub

# Local test mode (DEBUG only, never in production): no call hours, closed days, 8 AM-9 PM calling window
# or campaign texting hours, to try things at any hour. Every page shows a banner while it's on.
# TEST_IGNORE_TIME_LIMITS=1
