# Loaded ONLY by the one-off "migrate" job (see compose.prod.yml), on top of app.env.
# Real file: /opt/sparktext/migrate.env (chmod 600). Web and workers never see these credentials.
DATABASE_URL=postgres://sparktext_migrator:CHANGE_ME@psql-sparktext-prod-01.postgres.database.azure.com:5432/sparktext?sslrootcert=/etc/ssl/certs/ca-certificates.crt
