# PRODUCTION app config TEMPLATE. Real file lives ONLY on the server: /opt/sparktext/app.env (chmod 600).
# Never commit the real file, never reuse local/dev secrets here. One "KEY=value" per line, no quotes,
# no inline comments. Generate secrets with: openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 50

# --- Core ---
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=app.sparktext.si,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://app.sparktext.si
PUBLIC_BASE_URL=https://app.sparktext.si
SECURE_HSTS_SECONDS=3600

# --- Database: least-privilege APP role (rows only, cannot change tables) ---
# verify-full + the container's CA bundle = encrypted AND the server's identity is checked.
DATABASE_URL=postgres://sparktext_app:CHANGE_ME@psql-sparktext-prod-01.postgres.database.azure.com:5432/sparktext?sslrootcert=/etc/ssl/certs/ca-certificates.crt
DB_SSLMODE=verify-full

# --- Logging ---
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# --- Email ---
BREVO_API_KEY=
ANYMAIL_WEBHOOK_SECRET=
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=info@sparktext.si
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SparkText <info@sparktext.si>

# --- Google login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMS provider ---
MESSAGING_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VALIDATE_WEBHOOKS=True

# --- AI (must be a HOSTED endpoint in production, not localhost) ---
AI_CLIENT=openai
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# --- Bot protection ---
TURNSTILE_ENABLED=False
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
